 TSYS01 WHERE ADM_GUBN = '4002' AND ADM_CODE = rc.CS_TYPE ) as csType, CASE WHEN INSTR(rc.CS_NOTE, CHR(30)) > 0 THEN CASE WHEN LENGTH(SUBSTR(rc.CS_NOTE, 1, INSTR(rc.CS_NOTE, CHR(30)) - 1)) > 30 THEN SUBSTR(SUBSTR(rc.CS_NOTE, 1, INSTR(rc.CS_NOTE, CHR(30)) - 1), 1, 30) || '...' ELSE SUBSTR(rc.CS_NOTE, 1, INSTR(rc.CS_NOTE, CHR(30)) - 1) END ELSE CASE WHEN LENGTH(rc.CS_NOTE) > 30 THEN SUBSTR(rc.CS_NOTE, 1, 30) || '...' ELSE rc.CS_NOTE END END as csNote, rc.CS_DATE as csDate, rc.CS_BANK as csBank, rc.CS_NAME as csName, rc.CS_CASH as csCash, ( SELECT ADM_SNAME FROM TSYS01 WHERE ADM_GUBN = '4003' AND ADM_CODE = rc.PRC_GUBN ) as prcGubn, rc.PRC_NOTE as prcNote, rc.EMG_GUBN as emgGubn, rc.RECALL_EMP as recallEmp, rc.RECALL_CUST as recallCust, rc.SAUP_GUBN as saupGubn, rc.DEL_GUBN as delGubn, TO_CHAR(rc.IN_DATE, 'YYYYMMDD') as inDate, TO_CHAR(rc.IN_DATE, 'HH24:MI:SS') as inTime, rc.IN_EMPNO as inEmpno, rc.UP_DATE as up_Date, rc.UP_EMPNO as upEmpno, ( SELECT ADM_SNAME FROM TSYS01 WHERE ADM_GUBN = '5000' AND ADM_CODE = rc.BUY_GUBN ) as buyGubn, rc.NEW_CS_TYPE as newCsType, rc.NEW_CS_SUB_TYPE as newCsSubType, rc.BUY_TYPE as buyType, rc.COMPLETION_CODE as completionCode, ( SELECT COUNT(*) FROM TBND01_MEMO WHERE CUST_CODE = rc.CUST_CODE AND PROJECT_CODE = rc.PROJECT_CODE AND PERSON_CODE = rc.PERSON_CODE AND CALL_CODE = rc.CALL_CODE ) as COUNTRE FROM ranked_consultations rc WHERE rc.rnum BETWEEN ? AND ? ORDER BY rc.priority, rc.IN_DATE DESC
