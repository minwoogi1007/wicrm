INTSUM, 0 AS CALLP , 0 AS TOTAL FROM TCNT01_POINT A WHERE PERSON_CODE IS NULL AND POINT_CHARGE IS NOT NULL AND POINT<0 AND TO_CHAR(IN_DATE, 'YYYYMM') = TO_CHAR(SYSDATE, 'YYYYMM') ) GROUP BY EMP_NAME) GROUP BY ROLLUP(EMP_NAME) ORDER BY EMP_NAME
